EMAIL_OTP_KEY= key_aleatoria_para_otp        

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_MODO_DEV=true # modo de desenvolvimento (true) ou produção (false)
    
LOGIN_2FA_EMAIL=true #modo de login com 2º fator por e-mail (true) ou sem 2º fator (false)

