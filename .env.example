DB_USER=seu_usuario
DB_PASSWORD=sua_senha
SENSOR_ID=1

CLIMA_LATITUDE=
CLIMA_LONGITUDE=
CLIMA_TIMEZONE=America/Recife
CLIMA_CACHE_SEGUNDOS=600
